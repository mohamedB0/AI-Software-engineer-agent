# Normalize line endings: keep LF in the repo, let Git convert on checkout per OS.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
