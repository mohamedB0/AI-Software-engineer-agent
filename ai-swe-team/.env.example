# LLM providers - get a free Groq key at https://console.groq.com
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=           # optional fallback
OPENAI_API_KEY=              # required only for ChromaDB RAG embeddings
GOOGLE_API_KEY=              # optional

# GitHub personal access token (repo scope required)
GITHUB_TOKEN=ghp_...
GITHUB_DEFAULT_ORG=your-org-or-username

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_swe_team
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_swe_team

# Docker sandbox image
SANDBOX_IMAGE=ai-swe-sandbox:latest
SANDBOX_NETWORK_DISABLED=true

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Path to the git repository the agents work in
REPO_PATH=.
